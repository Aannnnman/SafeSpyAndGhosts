    - target: {fileID: 4410161414918852657, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: m_Text
      value: "Huh? Why am I floating?!\r\nWait... Why is my body down there while
        I'm up here?\r\nIs this the land of ghosts? They just want to rest in peace...
        \nJust like me."
