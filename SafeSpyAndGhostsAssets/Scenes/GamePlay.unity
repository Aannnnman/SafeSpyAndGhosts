    - target: {fileID: 5142507506568417297, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: m_Text
      value: "I've been wandering around for quite a while now... \nI wonder if I'll
        ever find my way out.\r\n\r\nThere are so many branches here... One branch,
        two branches...\r\n\r\nWait, I think I saw something! It looks like a human.\r\n\r\nI'll
        get a little closer. Maybe they'll give me some food?"
      objectReference: {fileID: 0}
    - target: {fileID: 5142507506568417297, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: m_FontData.m_FontSize
