    - target: {fileID: 6190858928820871021, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: _requiredCurrency
      value: 100000
      objectReference: {fileID: 0}
    - target: {fileID: 6670967161023202721, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: m_Text
      value: 'Just wandering around as usual... Boo!

        It''s kinda scary...
        Even though I''m a ghost, other ghosts still freak me out.

        Whoa!
        One branch, two branches...

        And look! A cat''s body! Plus a head...
        And plus another cat body?!'
      objectReference: {fileID: 0}
    - target: {fileID: 6670967161023202721, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
