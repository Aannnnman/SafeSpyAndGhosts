    - target: {fileID: 5142507506568417297, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: m_Text
      value: "Poor kitty... This is so sad. I'm sad...\r\n\r\nEver since I became
        a ghost, all I've been doing is wandering around aimlessly. \nWhat's even
        the point of all this?\r\n\r\nOh!!!!!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 5142507506568417297, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: m_FontData.m_FontSize
      value: 55
      objectReference: {fileID: 0}
    - target: {fileID: 5142507506568417297, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
