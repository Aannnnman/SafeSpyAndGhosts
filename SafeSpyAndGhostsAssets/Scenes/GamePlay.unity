      value: 1.33
      objectReference: {fileID: 0}
    - target: {fileID: 6190858928820871021, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: _game
      value: 
      objectReference: {fileID: 1611446018}
    - target: {fileID: 6670967161023202721, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
      propertyPath: m_Text
      value: 'Meow, meow, meow!

        I''m lost... Where am I?

        Can
        someone please help me?!

        Help me! Help meow!'
      objectReference: {fileID: 0}
    - target: {fileID: 6670967161023202721, guid: 0dc33e3ab8d084c448f001f95e4af56f, type: 3}
